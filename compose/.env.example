# Gateway Harness Appliance Configuration

# Deployment Secret Keys
LITELLM_MASTER_KEY=sk-gh-change-me-to-a-secure-random-key
GH_ADMIN_TOKEN=gh-admin-change-me-to-a-secure-random-token
POSTGRES_PASSWORD=change-me-to-a-secure-postgres-password

# Database Configuration
POSTGRES_USER=llmproxy
POSTGRES_DB=litellm
GH_DATABASE_URL=postgresql://llmproxy:${POSTGRES_PASSWORD}@postgres:5432/litellm
DATABASE_URL=postgresql://llmproxy:${POSTGRES_PASSWORD}@postgres:5432/litellm

# Appliance Operating Modes
GH_DEFAULT_MODE=observe
GH_GLOBAL_KILL=false
GH_DAILY_OPTIMIZER_BUDGET_USD=20.0
GH_OBSERVATION_DAYS=10

# Worker and Model Configuration
GH_JUDGE_MODEL=claude-3-5-sonnet
GH_PROPOSER_MODEL=claude-3-5-sonnet
GH_INTERNAL_KEY=sk-gh-change-me-to-a-secure-random-key
GH_GATEWAY_URL=http://gateway:4000
GH_DATA_DIR=/data
GH_WORKERS=4
